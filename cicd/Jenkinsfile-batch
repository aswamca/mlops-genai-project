pipeline {
    agent any

    triggers {
        // Run every Sunday at midnight.
        cron('0 0 * * 0')
        // Git push triggering is configured through the Jenkins webhook.
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_ACCOUNT_ID        = credentials('AWS_ACCOUNT_ID')
        AWS_REGION            = 'ap-southeast-2'
        BATCH_REPOSITORY      = 'predml-batch'
        API_REPOSITORY        = 'predml-api'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Windows tools') {
            steps {
                bat '''
                    @echo off
                    where aws
                    if errorlevel 1 exit /b 1
                    where docker
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build & Push predml-batch') {
            // Rebuild the image only when the batch source changes.
            when {
                anyOf {
                    changeset 'PredML/AWS/src/config.py'
                    changeset 'PredML/AWS/src/mlflow_registry.py'
                    changeset 'PredML/AWS/src/requirements-aws.txt'
                    changeset 'PredML/AWS/src/01_preprocess.py'
                    changeset 'PredML/AWS/src/02_feature_engineering.py'
                    changeset 'PredML/AWS/src/03_feature_store.py'
                    changeset 'PredML/AWS/src/04_train_model.py'
                    changeset 'PredML/AWS/src/05_register_model.py'
                    changeset 'PredML/AWS/src/06_batch_inference.py'
                    changeset 'PredML/AWS/src/08_model_monitoring.py'
                    changeset 'PredML/AWS/src/09_forecast.py'
                    changeset 'PredML/AWS/src/10_rollback.py'
                    changeset 'PredML/docker/batch.Dockerfile'
                }
            }
            steps {
                bat '''
                    @echo off
                    set "ECR_REGISTRY=%AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com"

                    aws ecr get-login-password --region "%AWS_REGION%" | docker login --username AWS --password-stdin "%ECR_REGISTRY%"
                    if errorlevel 1 exit /b 1

                    docker build -t "%BATCH_REPOSITORY%:latest" -f PredML\\docker\\batch.Dockerfile PredML
                    if errorlevel 1 exit /b 1
                    docker tag "%BATCH_REPOSITORY%:latest" "%ECR_REGISTRY%/%BATCH_REPOSITORY%:latest"
                    docker push "%ECR_REGISTRY%/%BATCH_REPOSITORY%:latest"
                    if errorlevel 1 exit /b 1
                    docker tag "%BATCH_REPOSITORY%:latest" "%ECR_REGISTRY%/%BATCH_REPOSITORY%:%BUILD_NUMBER%"
                    docker push "%ECR_REGISTRY%/%BATCH_REPOSITORY%:%BUILD_NUMBER%"
                '''
            }
        }

        stage('Build & Push realtime API') {
            when {
                anyOf {
                    changeset 'PredML/src/config.py'
                    changeset 'PredML/src/mlflow_registry.py'
                    changeset 'PredML/src/07_realtime_inference.py'
                    changeset 'PredML/src/09_forecast.py'
                    changeset 'PredML/docker/api.Dockerfile'
                    changeset 'PredML/docker/requirements-api.txt'
                }
            }
            steps {
                bat '''
                    @echo off
                    set "ECR_REGISTRY=%AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com"

                    aws ecr get-login-password --region "%AWS_REGION%" | docker login --username AWS --password-stdin "%ECR_REGISTRY%"
                    if errorlevel 1 exit /b 1

                    docker build -t "%API_REPOSITORY%:latest" -f PredML\\docker\\api.Dockerfile PredML
                    if errorlevel 1 exit /b 1
                    docker tag "%API_REPOSITORY%:latest" "%ECR_REGISTRY%/%API_REPOSITORY%:latest"
                    docker push "%ECR_REGISTRY%/%API_REPOSITORY%:latest"
                '''
            }
        }

    }

    post {
        always {
            bat '''
                @echo off
                set "ECR_REGISTRY=%AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com"
                docker logout "%ECR_REGISTRY%" >nul 2>&1
                exit /b 0
            '''
            deleteDir()
        }
        success {
            echo 'PredML image pipeline completed successfully'
        }
        failure {
            echo 'PredML image build or push failed - check logs'
        }
    }
}
