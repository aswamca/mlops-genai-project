pipeline {
    agent {
        label 'predml-ci'
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_REGION            = 'ap-southeast-2'
        TF_VAR_s3_bucket_name = 'predml-data-ap-southeast-2'
        TF_STATE_BUCKET       = 'predml-terraform-state-ap-southeast-2'
        TF_STATE_KEY          = 'predml/terraform.tfstate'
        TF_ROOT               = 'PredML/AWS/terraform'
        TF_CLI_ARGS           = '-no-color'
    }

    parameters {
        choice(
            name: 'TF_ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to run'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify AWS and Terraform') {
            steps {
                sh '''
                    set -eu

                    aws sts get-caller-identity --region "${AWS_REGION}" >/dev/null
                    terraform version
                '''
            }
        }

        stage('Prepare Terraform backend') {
            steps {
                sh '''
                    set -eu

                    if ! aws s3api head-bucket \
                        --bucket "${TF_STATE_BUCKET}" \
                        --region "${AWS_REGION}" >/dev/null 2>&1; then
                        aws s3api create-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_REGION}" \
                            --create-bucket-configuration \
                                LocationConstraint="${AWS_REGION}"
                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled
                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration \
                                '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
                    fi
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${env.TF_ROOT}") {
                    sh '''
                        set -eu

                        terraform init \
                            -upgrade \
                            -reconfigure \
                            -backend-config="bucket=${TF_STATE_BUCKET}" \
                            -backend-config="key=${TF_STATE_KEY}" \
                            -backend-config="region=${AWS_REGION}"
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${env.TF_ROOT}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${env.TF_ROOT}") {
                    sh '''
                        set -eu

                        if [ "${TF_ACTION}" = "destroy" ]; then
                            terraform plan \
                                -destroy \
                                -out=tfplan
                        else
                            terraform plan -out=tfplan
                        fi
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { params.TF_ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_ROOT}") {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression { params.TF_ACTION == 'destroy' }
            }
            steps {
                dir("${env.TF_ROOT}") {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }

    post {
        success {
            echo "Terraform ${params.TF_ACTION} completed successfully"
        }
        failure {
            echo "Terraform ${params.TF_ACTION} failed - check logs"
        }
        always {
            dir("${env.TF_ROOT}") {
                archiveArtifacts(
                    artifacts: 'tfplan',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }
    }
}
