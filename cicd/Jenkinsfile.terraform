pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_REGION            = 'ap-southeast-2'
        TF_VAR_s3_bucket_name = 'predml-data-ap-southeast-2'
        TF_STATE_BUCKET       = 'predml-terraform-state-ap-southeast-2'
        TF_STATE_KEY          = 'predml/terraform.tfstate'
        TF_ROOT               = 'PredML/AWS/terraform'
        TF_CLI_ARGS           = '-no-color'
        PATH                  = "C:\\Users\\ASWAD\\AppData\\Local\\Python\\bin;C:\\Users\\ASWAD\\AppData\\Local\\Python\\bin\\Scripts;${env.PATH}"
    }

    parameters {
        choice(
            name: 'TF_ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to run'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify AWS and Terraform') {
            steps {
                bat '''
                    @echo off
                    aws sts get-caller-identity --region "%AWS_REGION%" >nul
                    if errorlevel 1 exit /b 1
                    terraform version
                    python --version
                '''
            }
        }

        stage('Prepare Terraform backend') {
            steps {
                bat '''
                    @echo off
                    aws s3api head-bucket --bucket "%TF_STATE_BUCKET%" --region "%AWS_REGION%" >nul 2>&1
                    if not errorlevel 1 goto :backend_ready

                    aws s3api create-bucket --bucket "%TF_STATE_BUCKET%" --region "%AWS_REGION%" --create-bucket-configuration LocationConstraint="%AWS_REGION%"
                    if errorlevel 1 exit /b 1
                    aws s3api put-bucket-versioning --bucket "%TF_STATE_BUCKET%" --versioning-configuration Status=Enabled
                    if errorlevel 1 exit /b 1
                    aws s3api put-bucket-encryption --bucket "%TF_STATE_BUCKET%" --server-side-encryption-configuration "{\"Rules\":[{\"ApplyServerSideEncryptionByDefault\":{\"SSEAlgorithm\":\"AES256\"}}]}"
                    if errorlevel 1 exit /b 1

                    :backend_ready
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${env.TF_ROOT}") {
                    bat '''
                        @echo off
                        terraform init -upgrade -reconfigure -backend-config="bucket=%TF_STATE_BUCKET%" -backend-config="key=%TF_STATE_KEY%" -backend-config="region=%AWS_REGION%"
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${env.TF_ROOT}") {
                    bat 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${env.TF_ROOT}") {
                    bat '''
                        @echo off
                        if /i "%TF_ACTION%"=="destroy" (
                            terraform plan -destroy -out=tfplan
                        ) else (
                            terraform plan -out=tfplan
                        )
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { params.TF_ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_ROOT}") {
                    bat 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Register SageMaker pipelines') {
            when {
                expression { params.TF_ACTION == 'apply' }
            }
            steps {
                dir("${env.TF_ROOT}") {
                    script {
                        def bucket = bat(
                            script: 'terraform output -raw s3_bucket_name',
                            returnStdout: true
                        ).trim().split('\r?\n')[-1]
                        def imageUri = bat(
                            script: 'terraform output -raw ecr_batch_uri',
                            returnStdout: true
                        ).trim().split('\r?\n')[-1]
                        def roleArn = bat(
                            script: 'terraform output -raw sagemaker_role_arn',
                            returnStdout: true
                        ).trim().split('\r?\n')[-1]
                        def trackingUri = bat(
                            script: 'terraform output -raw mlflow_tracking_uri',
                            returnStdout: true
                        ).trim().split('\r?\n')[-1]
                        withEnv([
                            "PIPELINE_BUCKET=${bucket}",
                            "PIPELINE_IMAGE_URI=${imageUri}",
                            "PIPELINE_ROLE_ARN=${roleArn}",
                            "PIPELINE_MLFLOW_URI=${trackingUri}"
                        ]) {
                            bat '''
                                @echo off
                                python ..\\..\\cicd\\register_sagemaker_pipelines.py ^
                                    --region "%AWS_REGION%" ^
                                    --bucket "%PIPELINE_BUCKET%" ^
                                    --image-uri "%PIPELINE_IMAGE_URI%" ^
                                    --role-arn "%PIPELINE_ROLE_ARN%" ^
                                    --tracking-uri "%PIPELINE_MLFLOW_URI%"
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression { params.TF_ACTION == 'destroy' }
            }
            steps {
                dir("${env.TF_ROOT}") {
                    bat 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }

    post {
        success {
            echo "Terraform ${params.TF_ACTION} completed successfully"
        }
        failure {
            echo "Terraform ${params.TF_ACTION} failed - check logs"
        }
        always {
            dir("${env.TF_ROOT}") {
                archiveArtifacts(
                    artifacts: 'tfplan',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }
    }
}
